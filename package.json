{
  "name": "pkg-version",
  "displayName": "Package Version Checker",
  "description": "Checks package versions in common manifest files (package.json, composer.json, requirements.txt, pyproject.toml, pubspec.yaml) for updates.",
  "version": "3.0.0",
  "publisher": "Abdullah-Dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/attaryz/pkg-version"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/package.json",
    "workspaceContains:**/composer.json",
    "workspaceContains:**/composer.lock",
    "workspaceContains:**/requirements.txt",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/pubspec.yaml",
    "workspaceContains:**/vendor/*/composer.json",
    "workspaceContains:**/vendor/composer/installed.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pkg-version.checkUpdates",
        "title": "Check for Package Updates",
        "icon": "$(search)"
      },
      {
        "command": "pkg-version.refreshDependencies",
        "title": "Refresh Dependencies",
        "icon": "$(refresh)"
      },
      {
        "command": "pkg-version.excludeFolder",
        "title": "Exclude Folder from Package Checks",
        "icon": "$(exclude)"
      },
      {
        "command": "pkg-version.excludeCustomPattern",
        "title": "Exclude Pattern",
        "icon": "$(exclude)"
      },
      {
        "command": "pkg-version.manageExclusions",
        "title": "Manage Exclusions",
        "icon": "$(gear)"
      },
      {
        "command": "pkg-version.removeFromExcludeList",
        "title": "Remove from Exclude List",
        "icon": "$(add)"
      },
      {
        "command": "pkg-version.updatePackage",
        "title": "Update Package",
        "icon": "$(arrow-up)"
      },
      {
        "command": "pkg-version.updateAllPackages",
        "title": "Update All Packages",
        "icon": "$(sync)"
      },
      {
        "command": "pkg-version.checkVulnerabilities",
        "title": "Check for Security Vulnerabilities",
        "icon": "$(shield)"
      },
      {
        "command": "pkg-version.exportVulnerabilityReport",
        "title": "Export Vulnerability Report",
        "icon": "$(export)"
      },
      {
        "command": "pkg-version.refreshFileInfo",
        "title": "Refresh File Info",
        "icon": "$(refresh)"
      },
      {
        "command": "pkg-version.removePackage",
        "title": "Remove Package",
        "icon": "$(trash)"
      },
      {
        "command": "pkg-version.scanPackageVulnerabilities",
        "title": "Scan for Vulnerabilities",
        "icon": "$(shield)"
      },
      {
        "command": "pkg-version.addPackageToExcludeList",
        "title": "Add to Exclude List",
        "icon": "$(exclude)"
      },
      {
        "command": "pkg-version.refreshManifestFile",
        "title": "Refresh Dependencies for This File",
        "icon": "$(refresh)"
      },
      {
        "command": "pkg-version.scanManifestVulnerabilities",
        "title": "Scan This File for Vulnerabilities",
        "icon": "$(shield)"
      },
      {
        "command": "pkg-version.viewPackageInfo",
        "title": "View Package Info",
        "icon": "$(info)"
      },
      {
        "command": "pkg-version.generateRequirementsTxt",
        "title": "Generate requirements.txt from Poetry",
        "icon": "$(file-add)"
      },
      {
        "command": "pkg-version.refreshSecurityReport",
        "title": "Refresh Security Report",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pkg-version.refreshDependencies",
          "when": "view == packageDependencies",
          "group": "navigation@0",
          "icon": "$(refresh)"
        },
        {
          "command": "pkg-version.refreshFileInfo",
          "when": "view == fileInfoView",
          "group": "navigation@0",
          "icon": "$(refresh)"
        },
        {
          "command": "pkg-version.updateAllPackages",
          "when": "view == packageDependencies",
          "group": "1_updates@1",
          "icon": "$(arrow-up)"
        },
        {
          "command": "pkg-version.checkVulnerabilities",
          "when": "view == packageDependencies",
          "group": "1_updates@2",
          "icon": "$(shield)"
        },
        {
          "command": "pkg-version.manageExclusions",
          "when": "view == packageDependencies",
          "group": "2_configuration@1",
          "icon": "$(gear)"
        },
        {
          "command": "pkg-version.excludeCustomPattern",
          "when": "view == packageDependencies",
          "group": "2_configuration@2",
          "icon": "$(exclude)"
        },
        {
          "command": "pkg-version.generateRequirementsTxt",
          "when": "view == packageDependencies",
          "group": "3_poetry@1",
          "icon": "$(file-add)"
        },
        {
          "command": "pkg-version.refreshSecurityReport",
          "when": "view == securityReportView",
          "group": "navigation@0",
          "icon": "$(refresh)"
        }
      ],
      "view/item/context": [
        {
          "command": "pkg-version.updatePackage",
          "when": "view == packageDependencies && viewItem == dependency",
          "group": "inline",
          "icon": "$(arrow-up)"
        },
        {
          "command": "pkg-version.updatePackage",
          "when": "view == packageDependencies && (viewItem == dependency || viewItem == package-dependency)",
          "group": "1_modification"
        },
        {
          "command": "pkg-version.removePackage",
          "when": "view == packageDependencies && (viewItem == dependency || viewItem == package-dependency)",
          "group": "1_modification"
        },
        {
          "command": "pkg-version.viewPackageInfo",
          "when": "view == packageDependencies && (viewItem == dependency || viewItem == package-dependency)",
          "group": "2_information"
        },
        {
          "command": "pkg-version.scanPackageVulnerabilities",
          "when": "view == packageDependencies && (viewItem == dependency || viewItem == package-dependency || viewItem == vulnerable-dependency)",
          "group": "3_security"
        },
        {
          "command": "pkg-version.addPackageToExcludeList",
          "when": "view == packageDependencies && (viewItem == dependency || viewItem == package-dependency || viewItem == vulnerable-dependency)",
          "group": "4_exclusion"
        },
        {
          "command": "pkg-version.refreshManifestFile",
          "when": "view == packageDependencies && viewItem == manifestFile",
          "group": "1_refresh"
        },
        {
          "command": "pkg-version.scanManifestVulnerabilities",
          "when": "view == packageDependencies && viewItem == manifestFile",
          "group": "2_security"
        },
        {
          "command": "pkg-version.removeFromExcludeList",
          "when": "view == packageDependencies && viewItem == excludedManifest",
          "group": "1_exclusion"
        }
      ],
      "explorer/context": [
        {
          "command": "pkg-version.excludeFolder",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "package-version-explorer",
          "title": "Package Versions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "package-version-explorer": [
        {
          "id": "packageDependencies",
          "name": "Dependencies",
          "contextualTitle": "Package Dependencies"
        },
        {
          "id": "securityReportView",
          "name": "Security Report",
          "contextualTitle": "Security Report"
        },
        {
          "id": "fileInfoView",
          "name": "File Info",
          "contextualTitle": "Selected File Info"
        }
      ]
    },
    "configuration": {
      "title": "Package Version Checker",
      "properties": {
        "pkgVersion.excludeFolders": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/vendor/**/vendor/**",
            "**/venv/**",
            "**/.git/**",
            "**/build/**",
            "**/.dart_tool/**",
            "**/dist/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/bin/**",
            "**/__pycache__/**"
          ],
          "description": "Glob patterns for folders to exclude when searching for package files. Note: When 'scanVendorDirectory' is enabled, only the top-level vendor directory is scanned, not nested packages."
        },
        "pkgVersion.scanVendorDirectory": {
          "type": "boolean",
          "default": true,
          "description": "Whether to scan the vendor directory for installed Composer packages when no composer.json is found."
        },
        "pkgVersion.composerPackageDetection": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "composer.json",
            "vendor"
          ],
          "description": "How to detect Composer packages: 'auto' (recommended - uses composer.json and vendor scanning), 'composer.json' (only from composer.json), or 'vendor' (only from vendor directory)."
        },
        "pkgVersion.useOSVProvider": {
          "type": "boolean",
          "default": true,
          "description": "Enable OSV.dev vulnerability scanning (free, no configuration required)"
        },
        "pkgVersion.useGitHubAdvisoryProvider": {
          "type": "boolean",
          "default": false,
          "description": "Enable GitHub Advisory Database vulnerability scanning (free, no configuration required)"
        },
        "pkgVersion.useSnykProvider": {
          "type": "boolean",
          "default": false,
          "description": "Enable Snyk vulnerability scanning (requires API token and organization ID)"
        },
        "pkgVersion.snykApiToken": {
          "type": "string",
          "default": "",
          "description": "API token for Snyk vulnerability scanning. Get your token from https://app.snyk.io/account (only needed if Snyk is enabled)"
        },
        "pkgVersion.snykOrgId": {
          "type": "string",
          "default": "",
          "description": "Snyk Organization ID for vulnerability scanning. Find your organization ID in your Snyk account settings at https://app.snyk.io (only needed if Snyk is enabled)"
        },
        "pkgVersion.enableVulnerabilityChecking": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic vulnerability checking when loading dependencies"
        },
        "pkgVersion.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan for vulnerabilities when package files are saved"
        },
        "pkgVersion.scanOnSaveDelay": {
          "type": "number",
          "default": 2000,
          "description": "Delay in milliseconds before scanning after save (to avoid excessive scans)"
        },
        "pkgVersion.hideVulnerabilitiesBelow": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "none",
          "description": "Hide vulnerabilities below this severity level (none = show all)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "pretest": "yarn compile && yarn lint",
    "test": "node ./test/runTest.js",
    "vsce": "vsce",
    "publish": "yarn compile && vsce publish --no-yarn",
    "package": "yarn compile && vsce package --no-yarn",
    "package-and-install": "yarn install && yarn package && code --install-extension pkg-version-2.6.0.vsix"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "js-yaml": "^4.1.1",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@secretlint/secretlint-formatter-sarif": "^11.2.4",
    "@secretlint/secretlint-rule-no-dotenv": "^11.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.3",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.2",
    "eslint": "^8.44.0",
    "glob": "^13.0.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.6"
  },
  "packageManager": "yarn@4.12.0"
}
